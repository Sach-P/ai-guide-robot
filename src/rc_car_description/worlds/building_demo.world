<?xml version="1.0"?>
<sdf version="1.8">
  <!--
    Building, 24 m x 18 m. All models are local SDF geometry.
    The central east-west lobby connects to two wings through 3 m openings.
    Each wing has a partition with a wide opening near the lobby.
    Destinations are static representations, not functional doors or machines.
    The world name matches the world-specific bridge topics in sim.launch.py.
    Default spawn (-2.74, -0.46) is in the open central aisle.
  -->
  <world name="cat_robotics_world">
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin filename="gz-sim8-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim8-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim8-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim8-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>
    <plugin filename="gz-sim8-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim8-contact-system" name="gz::sim::systems::Contact"/>

    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.7 0.75 0.8 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -1</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision_collision">
          <geometry><plane><normal>0 0 1</normal><size>24 18</size></plane></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>24 18</size></plane></geometry>
          <material><ambient>0.55 0.55 0.52 1</ambient><diffuse>0.68 0.68 0.64 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- No ceiling: keeps the environment easy to view in Gazebo. -->
    <model name="walls">
      <static>true</static>
      <link name="link">
        <collision name="collision_north"><pose>0 9 1.5 0 0 0</pose><geometry><box><size>24.2 0.2 3</size></box></geometry></collision>
        <collision name="collision_south"><pose>0 -9 1.5 0 0 0</pose><geometry><box><size>24.2 0.2 3</size></box></geometry></collision>
        <collision name="collision_east"><pose>12 0 1.5 0 0 0</pose><geometry><box><size>0.2 18 3</size></box></geometry></collision>
        <collision name="collision_west"><pose>-12 0 1.5 0 0 0</pose><geometry><box><size>0.2 18 3</size></box></geometry></collision>
        <visual name="north"><pose>0 9 1.5 0 0 0</pose><geometry><box><size>24.2 0.2 3</size></box></geometry><material><ambient>0.75 0.74 0.70 1</ambient><diffuse>0.88 0.87 0.82 1</diffuse></material></visual>
        <visual name="south"><pose>0 -9 1.5 0 0 0</pose><geometry><box><size>24.2 0.2 3</size></box></geometry><material><ambient>0.75 0.74 0.70 1</ambient><diffuse>0.88 0.87 0.82 1</diffuse></material></visual>
        <visual name="east"><pose>12 0 1.5 0 0 0</pose><geometry><box><size>0.2 18 3</size></box></geometry><material><ambient>0.75 0.74 0.70 1</ambient><diffuse>0.88 0.87 0.82 1</diffuse></material></visual>
        <visual name="west"><pose>-12 0 1.5 0 0 0</pose><geometry><box><size>0.2 18 3</size></box></geometry><material><ambient>0.75 0.74 0.70 1</ambient><diffuse>0.88 0.87 0.82 1</diffuse></material></visual>
      </link>
    </model>

    <!-- The openings at x=[-8,-5] and x=[4,7] connect each wing to the lobby. -->
    <model name="interior_walls">
      <static>true</static>
      <link name="link">
        <collision name="north_west_collision"><pose>-10 3.5 1.5 0 0 0</pose><geometry><box><size>4 0.2 3</size></box></geometry></collision>
        <collision name="north_center_collision"><pose>-0.5 3.5 1.5 0 0 0</pose><geometry><box><size>9 0.2 3</size></box></geometry></collision>
        <collision name="north_east_collision"><pose>9.5 3.5 1.5 0 0 0</pose><geometry><box><size>5 0.2 3</size></box></geometry></collision>
        <collision name="south_west_collision"><pose>-10 -3.5 1.5 0 0 0</pose><geometry><box><size>4 0.2 3</size></box></geometry></collision>
        <collision name="south_center_collision"><pose>-0.5 -3.5 1.5 0 0 0</pose><geometry><box><size>9 0.2 3</size></box></geometry></collision>
        <collision name="south_east_collision"><pose>9.5 -3.5 1.5 0 0 0</pose><geometry><box><size>5 0.2 3</size></box></geometry></collision>
        <collision name="north_partition_collision"><pose>0 7.6 1.5 0 0 0</pose><geometry><box><size>0.2 2.8 3</size></box></geometry></collision>
        <collision name="south_partition_collision"><pose>0 -7.6 1.5 0 0 0</pose><geometry><box><size>0.2 2.8 3</size></box></geometry></collision>
        <visual name="north_west"><pose>-10 3.5 1.5 0 0 0</pose><geometry><box><size>4 0.2 3</size></box></geometry><material><ambient>0.65 0.68 0.7 1</ambient><diffuse>0.8 0.83 0.85 1</diffuse></material></visual>
        <visual name="north_center"><pose>-0.5 3.5 1.5 0 0 0</pose><geometry><box><size>9 0.2 3</size></box></geometry><material><ambient>0.65 0.68 0.7 1</ambient><diffuse>0.8 0.83 0.85 1</diffuse></material></visual>
        <visual name="north_east"><pose>9.5 3.5 1.5 0 0 0</pose><geometry><box><size>5 0.2 3</size></box></geometry><material><ambient>0.65 0.68 0.7 1</ambient><diffuse>0.8 0.83 0.85 1</diffuse></material></visual>
        <visual name="south_west"><pose>-10 -3.5 1.5 0 0 0</pose><geometry><box><size>4 0.2 3</size></box></geometry><material><ambient>0.65 0.68 0.7 1</ambient><diffuse>0.8 0.83 0.85 1</diffuse></material></visual>
        <visual name="south_center"><pose>-0.5 -3.5 1.5 0 0 0</pose><geometry><box><size>9 0.2 3</size></box></geometry><material><ambient>0.65 0.68 0.7 1</ambient><diffuse>0.8 0.83 0.85 1</diffuse></material></visual>
        <visual name="south_east"><pose>9.5 -3.5 1.5 0 0 0</pose><geometry><box><size>5 0.2 3</size></box></geometry><material><ambient>0.65 0.68 0.7 1</ambient><diffuse>0.8 0.83 0.85 1</diffuse></material></visual>
        <visual name="north_partition"><pose>0 7.6 1.5 0 0 0</pose><geometry><box><size>0.2 2.8 3</size></box></geometry><material><ambient>0.65 0.68 0.7 1</ambient><diffuse>0.8 0.83 0.85 1</diffuse></material></visual>
        <visual name="south_partition"><pose>0 -7.6 1.5 0 0 0</pose><geometry><box><size>0.2 2.8 3</size></box></geometry><material><ambient>0.65 0.68 0.7 1</ambient><diffuse>0.8 0.83 0.85 1</diffuse></material></visual>
      </link>
    </model>

    <model name="mens_restroom">
      <static>true</static><pose>3 8.77 0 0 0 0</pose>
      <link name="link">
        <collision name="collision_door"><pose>0 0 1.05 0 0 0</pose><geometry><box><size>1.1 0.22 2.1</size></box></geometry></collision>
        <visual name="door"><pose>0 0 1.05 0 0 0</pose><geometry><box><size>1.1 0.22 2.1</size></box></geometry><material><ambient>0.25 0.2 0.14 1</ambient><diffuse>0.4 0.3 0.2 1</diffuse></material></visual>
        <visual name="handle"><pose>0.4 -0.13 1 1.5708 0 0</pose><geometry><cylinder><radius>0.035</radius><length>0.04</length></cylinder></geometry><material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <visual name="handle_lever"><pose>0.34 -0.16 1 0 0 0</pose><geometry><box><size>0.15 0.04 0.035</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <visual name="door_frame_left"><pose>-0.51 -0.12 1.05 0 0 0</pose><geometry><box><size>0.08 0.05 2.1</size></box></geometry><material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
        <visual name="door_frame_right"><pose>0.51 -0.12 1.05 0 0 0</pose><geometry><box><size>0.08 0.05 2.1</size></box></geometry><material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
        <!-- Blue sign with a white, simplified person pictogram. -->
        <visual name="sign"><pose>0 -0.13 1.35 0 0 0</pose><geometry><box><size>0.35 0.025 0.4</size></box></geometry><material><ambient>0.02 0.15 0.5 1</ambient><diffuse>0.04 0.3 0.8 1</diffuse></material></visual>
        <visual name="person_head"><pose>0 -0.153 1.46 1.5708 0 0</pose><geometry><cylinder><radius>0.045</radius><length>0.02</length></cylinder></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="person_body"><pose>0 -0.153 1.34 0 0 0</pose><geometry><box><size>0.08 0.02 0.15</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="person_arms"><pose>0 -0.153 1.38 0 0 0</pose><geometry><box><size>0.18 0.02 0.035</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="person_left_leg"><pose>-0.027 -0.153 1.24 0 0 0</pose><geometry><box><size>0.035 0.02 0.1</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="person_right_leg"><pose>0.027 -0.153 1.24 0 0 0</pose><geometry><box><size>0.035 0.02 0.1</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      </link>
    </model>

    <model name="womens_restroom">
      <static>true</static><pose>5.1 8.77 0 0 0 0</pose>
      <link name="link">
        <collision name="collision_door"><pose>0 0 1.05 0 0 0</pose><geometry><box><size>1.1 0.22 2.1</size></box></geometry></collision>
        <visual name="door"><pose>0 0 1.05 0 0 0</pose><geometry><box><size>1.1 0.22 2.1</size></box></geometry><material><ambient>0.25 0.2 0.14 1</ambient><diffuse>0.4 0.3 0.2 1</diffuse></material></visual>
        <visual name="frame_left"><pose>-0.51 -0.12 1.05 0 0 0</pose><geometry><box><size>0.08 0.05 2.1</size></box></geometry><material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
        <visual name="frame_right"><pose>0.51 -0.12 1.05 0 0 0</pose><geometry><box><size>0.08 0.05 2.1</size></box></geometry><material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
        <visual name="handle"><pose>0.35 -0.16 1 0 0 0</pose><geometry><box><size>0.15 0.04 0.035</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <visual name="sign"><pose>0 -0.13 1.35 0 0 0</pose><geometry><box><size>0.35 0.025 0.4</size></box></geometry><material><ambient>0.02 0.15 0.5 1</ambient><diffuse>0.04 0.3 0.8 1</diffuse></material></visual>
        <visual name="head"><pose>0 -0.153 1.46 1.5708 0 0</pose><geometry><cylinder><radius>0.045</radius><length>0.02</length></cylinder></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="body"><pose>0 -0.153 1.39 0 0 0</pose><geometry><box><size>0.075 0.02 0.10</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="dress"><pose>0 -0.153 1.31 0 0 0</pose><geometry><box><size>0.16 0.02 0.10</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="arms"><pose>0 -0.153 1.38 0 0 0</pose><geometry><box><size>0.18 0.02 0.035</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="left_leg"><pose>-0.035 -0.153 1.24 0 0 0</pose><geometry><box><size>0.035 0.02 0.1</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="right_leg"><pose>0.035 -0.153 1.24 0 0 0</pose><geometry><box><size>0.035 0.02 0.1</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      </link>
    </model>

    <model name="snack_vending_machine">
      <static>true</static><pose>9 2.975 0 0 0 0</pose>
      <link name="link">
        <collision name="collision_body"><pose>0 0 1 0 0 0</pose><geometry><box><size>1.1 0.85 2</size></box></geometry></collision>
        <visual name="body"><pose>0 0 1 0 0 0</pose><geometry><box><size>1.1 0.85 2</size></box></geometry><material><ambient>0.55 0.04 0.04 1</ambient><diffuse>0.8 0.06 0.06 1</diffuse></material></visual>
        <visual name="display"><pose>-0.12 -0.435 1.3 0 0 0</pose><geometry><box><size>0.68 0.025 1.05</size></box></geometry><material><ambient>0.04 0.06 0.08 1</ambient><diffuse>0.1 0.14 0.17 1</diffuse></material></visual>
        <visual name="shelf_1"><pose>-0.12 -0.46 1.55 0 0 0</pose><geometry><box><size>0.58 0.025 0.03</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <visual name="shelf_2"><pose>-0.12 -0.46 1.18 0 0 0</pose><geometry><box><size>0.58 0.025 0.03</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <visual name="snack_yellow"><pose>-0.30 -0.47 1.67 0 0 0</pose><geometry><box><size>0.14 0.03 0.18</size></box></geometry><material><ambient>0.9 0.7 0.05 1</ambient><diffuse>1 0.8 0.08 1</diffuse></material></visual>
        <visual name="snack_blue"><pose>-0.10 -0.47 1.67 0 0 0</pose><geometry><box><size>0.14 0.03 0.18</size></box></geometry><material><ambient>0.05 0.2 0.7 1</ambient><diffuse>0.08 0.35 1 1</diffuse></material></visual>
        <visual name="snack_green"><pose>0.10 -0.47 1.67 0 0 0</pose><geometry><box><size>0.14 0.03 0.18</size></box></geometry><material><ambient>0.05 0.55 0.12 1</ambient><diffuse>0.1 0.8 0.2 1</diffuse></material></visual>
        <visual name="snack_orange"><pose>-0.30 -0.47 1.30 0 0 0</pose><geometry><box><size>0.14 0.03 0.18</size></box></geometry><material><ambient>0.8 0.3 0.03 1</ambient><diffuse>1 0.45 0.05 1</diffuse></material></visual>
        <visual name="snack_white"><pose>-0.10 -0.47 1.30 0 0 0</pose><geometry><box><size>0.14 0.03 0.18</size></box></geometry><material><ambient>0.8 0.8 0.75 1</ambient><diffuse>1 1 0.9 1</diffuse></material></visual>
        <visual name="snack_purple"><pose>0.10 -0.47 1.30 0 0 0</pose><geometry><box><size>0.14 0.03 0.18</size></box></geometry><material><ambient>0.45 0.08 0.55 1</ambient><diffuse>0.7 0.1 0.8 1</diffuse></material></visual>
        <!-- Cans and package markings give the display depth and texture without text. -->
        <visual name="can_red"><pose>-0.30 -0.475 0.96 0 0 0</pose><geometry><cylinder><radius>0.06</radius><length>0.19</length></cylinder></geometry><material><ambient>0.75 0.06 0.03 1</ambient><diffuse>1 0.1 0.04 1</diffuse></material></visual>
        <visual name="can_blue"><pose>-0.10 -0.475 0.96 0 0 0</pose><geometry><cylinder><radius>0.06</radius><length>0.19</length></cylinder></geometry><material><ambient>0.03 0.2 0.7 1</ambient><diffuse>0.06 0.35 0.95 1</diffuse></material></visual>
        <visual name="can_green"><pose>0.10 -0.475 0.96 0 0 0</pose><geometry><cylinder><radius>0.06</radius><length>0.19</length></cylinder></geometry><material><ambient>0.04 0.6 0.12 1</ambient><diffuse>0.08 0.85 0.2 1</diffuse></material></visual>
        <visual name="can_red_top"><pose>-0.30 -0.475 1.058 0 0 0</pose><geometry><cylinder><radius>0.058</radius><length>0.01</length></cylinder></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <visual name="can_blue_top"><pose>-0.10 -0.475 1.058 0 0 0</pose><geometry><cylinder><radius>0.058</radius><length>0.01</length></cylinder></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <visual name="can_green_top"><pose>0.10 -0.475 1.058 0 0 0</pose><geometry><cylinder><radius>0.058</radius><length>0.01</length></cylinder></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <visual name="package_mark_yellow"><pose>-0.30 -0.49 1.67 1.5708 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.01</length></cylinder></geometry><material><ambient>0.8 0.08 0.03 1</ambient><diffuse>1 0.12 0.05 1</diffuse></material></visual>
        <visual name="package_mark_blue"><pose>-0.10 -0.49 1.67 1.5708 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.01</length></cylinder></geometry><material><ambient>0.9 0.9 0.8 1</ambient><diffuse>1 1 0.9 1</diffuse></material></visual>
        <visual name="package_mark_green"><pose>0.10 -0.49 1.67 1.5708 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.01</length></cylinder></geometry><material><ambient>0.9 0.8 0.1 1</ambient><diffuse>1 0.9 0.2 1</diffuse></material></visual>
        <visual name="shelf_3"><pose>-0.12 -0.48 0.85 0 0 0</pose><geometry><box><size>0.58 0.025 0.03</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <visual name="display_left_trim"><pose>-0.48 -0.45 1.3 0 0 0</pose><geometry><box><size>0.04 0.04 1.1</size></box></geometry><material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
        <visual name="display_right_trim"><pose>0.24 -0.45 1.3 0 0 0</pose><geometry><box><size>0.04 0.04 1.1</size></box></geometry><material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
        <visual name="payment_panel"><pose>0.40 -0.44 1.25 0 0 0</pose><geometry><box><size>0.16 0.03 0.5</size></box></geometry><material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <visual name="payment_screen"><pose>0.40 -0.461 1.4 0 0 0</pose><geometry><box><size>0.11 0.012 0.09</size></box></geometry><material><ambient>0.08 0.45 0.7 1</ambient><diffuse>0.15 0.7 1 1</diffuse></material></visual>
        <visual name="selection_buttons"><pose>0.40 -0.461 1.22 0 0 0</pose><geometry><box><size>0.10 0.012 0.12</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="coin_slot"><pose>0.40 -0.461 1.06 0 0 0</pose><geometry><box><size>0.06 0.012 0.02</size></box></geometry><material><ambient>0.75 0.7 0.45 1</ambient><diffuse>0.9 0.85 0.6 1</diffuse></material></visual>
        <visual name="collection_slot"><pose>-0.08 -0.44 0.35 0 0 0</pose><geometry><box><size>0.65 0.03 0.2</size></box></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.07 0.07 0.07 1</diffuse></material></visual>
      </link>
    </model>

    <model name="trash_can">
      <static>true</static><pose>9 -2.8 0 0 0 0</pose>
      <link name="link">
        <collision name="collision_body"><pose>0 0 0.45 0 0 0</pose><geometry><cylinder><radius>0.28</radius><length>0.9</length></cylinder></geometry></collision>
        <visual name="body"><pose>0 0 0.45 0 0 0</pose><geometry><cylinder><radius>0.28</radius><length>0.9</length></cylinder></geometry><material><ambient>0.13 0.13 0.13 1</ambient><diffuse>0.23 0.23 0.23 1</diffuse></material></visual>
        <visual name="lid"><pose>0 0 0.91 0 0 0</pose><geometry><cylinder><radius>0.3</radius><length>0.05</length></cylinder></geometry><material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
        <visual name="lid_opening"><pose>0 0 0.941 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>0.01</length></cylinder></geometry><material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.04 0.04 0.04 1</diffuse></material></visual>
        <visual name="foot_pedal"><pose>0 -0.31 0.06 0 0 0</pose><geometry><box><size>0.18 0.16 0.08</size></box></geometry><material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Waiting area in the northwest wing. -->
    <model name="waiting_table">
      <static>true</static><pose>-9 6 0 0 0 0.3</pose>
      <link name="link">
        <collision name="collision_top"><pose>0 0 0.75 0 0 0</pose><geometry><box><size>1.3 0.9 0.1</size></box></geometry></collision>
        <collision name="collision_pedestal"><pose>0 0 0.36 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.72</length></cylinder></geometry></collision>
        <visual name="top"><pose>0 0 0.75 0 0 0</pose><geometry><box><size>1.3 0.9 0.1</size></box></geometry><material><ambient>0.45 0.28 0.15 1</ambient><diffuse>0.65 0.42 0.23 1</diffuse></material></visual>
        <visual name="pedestal"><pose>0 0 0.36 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.72</length></cylinder></geometry><material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
      </link>
    </model>

    <model name="waiting_chair_west">
